# ==============================================================================
# Country Research & Relocation Scoring Criteria (.env.example)
# Шаблон критеріїв релокації / Шаблон критериев релокации
# ==============================================================================

# --- Origin & Logistics / Логістика та точка старту / Логистика и точка старта ---
# City of departure / Місто виїзду / Город выезда (e.g. "Kyiv, UA" | "Warsaw, PL")
ORIGIN_CITY="City, Country"
# Nearest border crossing or hub / Найближчий КПП або хаб / Ближайший КПП или хаб
ORIGIN_BORDER_CROSSING="Border Crossing / Airport"
# Regular prescription medicine delivery needed? / Потрібна доставка рецептурних ліків? / Нужна доставка рецептурных лекарств? (true | false)
MEDICINE_DELIVERY_REQUIRED=false
# Preferred delivery channel / Канал доставки / Канал доставки ("postal_service" | "bus_carriers" | "local_pharmacy" | "none")
MEDICINE_DELIVERY_CHANNEL="postal_service"

# --- Legal & Military Status / Правовий та військовий статус / Правовой и воинский статус ---
# Military status / Військовий статус / Воинский статус:
#   "official_deferral" — офіційна відстрочка (залишається на обліку) / официальная отсрочка (остаётся на учёте)
#   "deregistered"      — повне зняття з військового обліку / полное снятие с воинского учёта
#   "exempt"            — звільнений від обов'язку / освобождён от обязанности
#   "not_applicable"    — не застосовується / не применимо
MILITARY_STATUS="not_applicable"
# Avoid countries requiring full military deregistration (not just deferral) for protection
# Уникати країн, які вимагають повного зняття з обліку, а не лише відстрочки
# Избегать стран, требующих полного снятия с учёта, а не только отсрочки
AVOID_MILITARY_RULE_COUNTRIES=false
# Prefer non-EU countries (fewer EU directive checks) / Надавати перевагу країнам поза ЄС / Предпочитать страны вне ЕС
PREFER_NON_EU=false

# --- Income, Work & Tax Mode / Дохід, робота та податки / Доход, работа и налоги ---
# Work format / Формат роботи / Формат работы: "remote_b2b" | "hybrid" | "relocation_package" | "local_employment"
WORK_FORMAT="remote_b2b"
# Tax residency mode / Податковий режим / Налоговый режим:
#   "ua_fop_3_group"    — український ФОП 3 гр. / украинский ФОП 3 гр.
#   "local_sole_trader" — місцевий підприємець / местный ИП
#   "local_company"     — місцева юрособа / местное юрлицо
#   "digital_nomad_visa"— віза цифрового кочівника / виза цифрового кочевника
TAX_MODE="local_sole_trader"
# Single Tax % (Єдиний податок / Единый налог), Military Levy % (Військовий збір / Военный сбор), Fixed social tax EUR (ЄСВ / ЕСВ)
UA_FOP_EP_PCT=0
UA_FOP_VZ_PCT=0
UA_FOP_ESV_EUR=0
# 183-day tax residency rule / Правило 183 днів податкового резидентства / Правило 183 дней налогового резидентства
TAX_FREE_DAYS_THRESHOLD=183
# Double Taxation Treaty (DTT): whether simplified/turnover tax counts as PIT credit
# Конвенція про уникнення подвійного оподаткування (DTT): чи зараховується єдиний податок як PIT (зазвичай false)
# Конвенция об избежании двойного налогообложения (DTT): засчитывается ли единый налог как PIT (обычно false)
DTT_UA_EP_CREDITED=false

# Workload & compensation placeholders / Навантаження та оплата / Нагрузка и оплата
HOURS_PER_MONTH=160
CURRENT_RATE_USD=20
# Raise negotiation status / Статус підвищення ставки / Статус повышения ставки: "confirmed" | "unconfirmed_possible" | "none"
RAISE_STATUS="none"
TARGET_RATE_EUR=25
# Optional recurring compensations or obligations (EUR/USD) / Додаткові витрати/компенсації / Доп. расходы/компенсации
THERAPY_COMP_USD=0
NET_AFTER_UA_EUR=1500
TAX_BASE_EUR=1500
PERSONAL_THERAPY_EUR=0
PERSONAL_MEDS_EUR=0
FAMILY_SUPPORT_UA_EUR=0
TARGET_RESERVE_EUR=200

# --- Budget, Housing & Climate / Бюджет, житло та клімат / Бюджет, жильё и климат ---
# Filter to low_budget_country=true only / Лише бюджетні країни / Только бюджетные страны (true | false)
LOW_BUDGET_ONLY=false
# Climate preference / Пріоритет клімату / Приоритет климата:
#   "warm_low_heating" — теплий клімат, мінімум витрат на опалення / тёплый климат, минимум затрат на отопление
#   "temperate"        — помірний / умеренный
#   "mountain_forest"  — гори та ліси / горы и леса
#   "any"              — будь-який / любой
PRIORITY_CLIMATE="any"
# Monthly heating savings target (EUR) / Цільова економія на опаленні / Целевая экономия на отоплении
HEATING_SAVINGS_TARGET_EUR="0"
# Housing crisis tolerance / Толерантність до кризи житла / Толерантность к жилищному кризису: "no_crisis" | "moderate" | "any"
HOUSING_CRISIS_TOLERANCE="any"

# --- Language, Career & Long-Term / Мова, кар'єра та перспектива / Язык, карьера и перспектива ---
# Require English-only bureaucracy & daily life / Достатньо лише англійської / Достаточно только английского (true | false)
ENGLISH_ONLY_REQUIRED=true
# Minimum local IT market size / Мінімальний ІТ-ринок / Минимальный IT-рынок: "top_eu" | "medium" | "any"
MIN_IT_MARKET="any"
# Max years to citizenship / Макс. років до громадянства / Макс. лет до гражданства
CITIZENSHIP_MAX_YEARS=10
# Mortgage availability for expats required? / Потрібна іпотека для експатів? / Нужна ипотека для экспатов?
MORTGAGE_REQUIRED=false
# Rent-to-buy option preferred? / Бажана оренда з викупом? / Желательна аренда с выкупом?
RENT_TO_BUY_PREFERRED=false
# Relocation package / Пакет релокації від роботодавця / Пакет релокации: "flight+temp_housing+english+hybrid" | "none"
RELOCATION_PACKAGE_REQUIRED="none"
SOCIAL_PROTECTION_PRIORITY="medium"
# Spiritual/philosophical community priority / Наявність духовної спільноти / Наличие духовного сообщества
SPIRITUAL_TEACHER_PRIORITY=false

# --- External Data Sources / Зовнішні джерела даних / Внешние источники данных ---
# Cost of living database / База вартості життя / База стоимости жизни: "numbeo" | "manual"
COST_OF_LIVING_SOURCE="numbeo"
# Weather/climate APIs (keyless) / Погодні API без ключа / Погодные API без ключа: "nasa_power,open_meteo" | "wttr_in"
WEATHER_API_SOURCE="nasa_power,open_meteo"
